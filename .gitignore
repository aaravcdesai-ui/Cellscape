.DS_Store
_site/
node_modules/

# Local references and review artifacts are not website assets.
design/recording-review/
design/*-ui-concept.png
/*.png
/*.jpg
/*.jpeg
*.mov
*.mp4

# Keep local credentials and machine-specific configuration out of Git.
.env
.env.*
!.env.example

# Private quiz records and exports
backend/data/
*.sqlite3
*.sqlite3-*
quiz-export*.csv
__pycache__/

# Admin credential hashes must never be committed.
admin.json

# Separate public hosting checkout (contains only the sanitized frontend).
sites/cellscape-public/
